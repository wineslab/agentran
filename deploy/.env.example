# Multi-Agent CommAG — Docker Compose environment
#
# Copy to .env and edit before running: docker compose up --build
#
# All services are self-contained; only the Ollama model and
# InfluxDB credentials need attention for a default local run.

# ───── InfluxDB ───────────────────────────────────────────────────────
INFLUXDB_TOKEN=agentran-dev-token
INFLUXDB_ORG=mwc
INFLUXDB_BUCKET=mwc-live
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=changeme-please
INFLUXDB_PORT=8086

# ───── Ollama LLM ───────────────────────────────────────────────────
# Model tag from the Ollama registry (https://ollama.com/library)
OLLAMA_MODEL=gpt-oss:20b

# ───── Agent config ──────────────────────────────────────────────────
DEFAULT_INTENT=Alternate the throughput limit for all UE classes between 1 Mbps and 3 Mbps every decision cycle. When the current limit is 1 set it to 3. When it is 3 set it to 1.

# ───── gNB control API ────────────────────────────────────────────────
GNB_API_PORT=8000

# ───── Grafana ────────────────────────────────────────────────────────
# Dashboard exposed at http://<host>:GRAFANA_PORT  (default: 3000)
# Login: admin / GRAFANA_PASSWORD  (anonymous viewers don't need a login)
GRAFANA_PORT=3000
GRAFANA_PASSWORD=agentran
